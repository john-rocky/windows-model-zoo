__pycache__/
*.pyc
.snap/
scratch/
# the tables that put runtimes side by side and the index: built on your disk only
#   python3 tools/table.py --local, python3 tools/task_pairs_vision.py, python3 tools/task_pairs_llm.py
RESULTS_*.md
TASK_PAIRS_*.md
models/index.json
# what tools/pc.sh pull brings back; the committed records are raw/z5/, raw/z6/, raw/z14/, raw/z13/, raw/z19/, raw/qwen25-igpu/, raw/qwen25-llamacpp/, raw/qwen25-05b/, raw/qwen25-ov-int8/ and raw/phi4-mini/ (the task
# cells), raw/walk/, raw/walk-z9/ and raw/walk-z12/ (the walks)
raw/*/
!raw/z5/
!raw/z6/
!raw/z14/
!raw/z13/
!raw/z19/
!raw/qwen25-igpu/
!raw/qwen25-llamacpp/
!raw/qwen25-05b/
!raw/qwen25-ov-int8/
!raw/phi4-mini/
!raw/walk/
!raw/walk-z9/
!raw/walk-z12/
# the vision task cells' outputs (npz, MB to tens of MB per cell) are not in this repo
raw/z5/**/*.npz
raw/z14/**/*.npz
raw/z13/**/*.npz
raw/walk/**/*.npz
raw/walk-z9/**/*.npz
raw/walk-z12/**/*.npz
# the PC step logs of the Z13, Z19, qwen25-igpu, qwen25-llamacpp, qwen25-05b, qwen25-ov-int8 and phi4-mini passes name the PC account's folder: they stay on your disk
raw/z13/logs/
raw/z19/logs/
raw/qwen25-igpu/logs/
raw/qwen25-llamacpp/logs/
raw/qwen25-05b/logs/
raw/qwen25-ov-int8/logs/
raw/phi4-mini/logs/
# a walk's cells and references written by tools/results.py --out (compared with the committed cells)
walk-out/
walk-out-*/
# a timed sitting's log on the Mac (tools/sitting.sh)
raw/*.sitting.log
# generated from the recipes by tools/plan.py (what the PC runs; written again before each push)
pc/plans/
pc/steps/
pc/hub_manifest.json
