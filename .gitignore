__pycache__/
*.pyc
.snap/
scratch/
# the tables that put runtimes side by side and the index: built on your disk only
#   python3 tools/table.py --local, python3 tools/task_pairs_vision.py, python3 tools/task_pairs_llm.py
RESULTS_*.md
TASK_PAIRS_*.md
models/index.json
# what tools/pc.sh pull brings back; the committed records are the folders named below (the task cells' folders,
# then the walks': raw/walk*/)
raw/*/
!raw/vision-task/
!raw/llm-qa20/
!raw/npu-rerun/
!raw/qwen3-int8-sym/
!raw/qwen25-15b/
!raw/qwen25-igpu/
!raw/qwen25-llamacpp/
!raw/qwen25-05b/
!raw/qwen25-ov-int8/
!raw/phi4-mini/
!raw/qwen3-ov-npu/
!raw/phi4-mini-ep/
!raw/phi4-mini-ov/
!raw/walk/
!raw/walk2/
!raw/walk-timed-paths/
# the vision task cells' outputs (npz, MB to tens of MB per cell) are not in this repo
raw/vision-task/**/*.npz
raw/npu-rerun/**/*.npz
raw/qwen3-int8-sym/**/*.npz
raw/walk/**/*.npz
raw/walk2/**/*.npz
raw/walk-timed-paths/**/*.npz
# the PC step logs of the passes below name the PC account's folder: they stay on your disk
raw/qwen3-int8-sym/logs/
raw/qwen25-15b/logs/
raw/qwen25-igpu/logs/
raw/qwen25-llamacpp/logs/
raw/qwen25-05b/logs/
raw/qwen25-ov-int8/logs/
raw/phi4-mini/logs/
raw/qwen3-ov-npu/logs/
raw/phi4-mini-ep/logs/
raw/phi4-mini-ov/logs/
# a walk's cells and references written by tools/results.py --out (compared with the committed cells)
walk-out/
walk-out-*/
# a timed sitting's log on the Mac (tools/sitting.sh)
raw/*.sitting.log
# generated from the recipes by tools/plan.py (what the PC runs; written again before each push)
pc/plans/
pc/steps/
pc/hub_manifest.json
