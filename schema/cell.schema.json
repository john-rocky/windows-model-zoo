{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "zoo-cell/1",
 "title": "One cell: one model x runtime x device x form, its run, its line and its numbers (models/<model>/results/<cell>.json)",
 "type": "object",
 "required": ["schema", "model", "cell", "kind", "runtime", "device", "form", "run", "line", "speed", "regime", "source", "note"],
 "properties": {
  "schema": {"const": "zoo-cell/1"},
  "model": {"type": "string", "description": "the model directory's name"},
  "cell": {"type": "string", "description": "the file's name without .json, and the recipe's [[cell]] id"},
  "kind": {"enum": ["vision", "llm", "asr", "tts"]},
  "role": {"enum": [null, "conversion-check", "other-device"],
           "description": "absent = a cell of this PC judged on its line; conversion-check = a check of the conversion, not a runtime cell; other-device = another device's record (no line)"},
  "row_line": {"type": ["string", "null"], "description": "the line of the table row a role cell sits in"},
  "sort_key": {"type": "string"},
  "runtime": {"type": "object", "required": ["id", "label"],
              "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "version": {"type": ["string", "null"]},
                             "ep": {"type": ["string", "null"]}}},
  "device": {"type": "object", "required": ["id", "label"],
             "properties": {"id": {"type": "string"}, "label": {"type": "string"}}},
  "form": {"type": "object", "required": ["id", "label"],
           "properties": {"id": {"type": ["string", "null"]}, "label": {"type": ["string", "null"]}}},
  "run": {"type": "object", "required": ["state"],
          "properties": {"state": {"enum": ["ok", "error", "timeout", "out", "not_run"]},
                         "mode": {"enum": [null, "first", "timed", "collected"]},
                         "started": {"type": ["string", "null"], "description": "ISO time with a zone; the line's written time must be earlier"},
                         "why": {"type": ["string", "null"]}}},
  "line": {"type": ["object", "null"], "required": ["id", "kind", "pass", "verdict"],
           "description": "null only for role other-device",
           "properties": {"id": {"type": "string"}, "kind": {"enum": ["task", "internal", "text-integrity", "reference"]},
                          "pass": {"type": ["boolean", "null"], "description": "null = no verdict (not run, error, a reference cell)"},
                          "verdict": {"type": "string", "description": "the verdict, the numbers and the line in one string, e.g. 'FAIL on qa20: 9 of 20 answers' first lines equal the reference's (pass mark 18); gate PASS; 12 of 20 right by the answer key' (tools/zoo.py verdict_text; tools/results.py writes it, tools/lint.py checks it)"}}},
  "speed": {"type": ["object", "null"], "required": ["metric"],
            "properties": {"metric": {"type": "string"},
                           "value": {"type": ["number", "null"], "description": "a timed number (null for a first pass: first_value)"},
                           "first_value": {"type": ["number", "null"]},
                           "timed": {"type": ["boolean", "null"]}}},
  "regime": {"type": ["object", "null"], "required": ["qos", "power"],
             "properties": {"qos": {"enum": ["high", "not-raised", "unknown", "n/a"]},
                            "power": {"enum": ["balanced", "extreme", "unrecorded", "n/a"]},
                            "timer": {"type": ["string", "null"]}}},
  "memory": {"type": ["object", "null"]},
  "source": {"type": "object", "required": ["by"],
             "properties": {"by": {"type": ["string", "null"]}, "record": {"type": ["string", "null"]},
                            "migrated_from": {"type": "string"}}},
  "note": {"type": "array", "items": {"type": "object", "required": ["rank", "text"],
                                       "properties": {"rank": {"type": "number"}, "text": {"type": "string"}}}},
  "vision": {"type": "object"},
  "llm": {"type": "object"},
  "audio": {"type": "object"}
 }
}
